NODE_ENV=development

WEB_PORT=3000
API_PORT=3001

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_targeting

POSTGRES_ADMIN_USER=admin_user
POSTGRES_ADMIN_PASSWORD=admin_password

POSTGRES_AGENT_USER=agent_reader
POSTGRES_AGENT_PASSWORD=agent_password

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=marketing-assets

# Chỉ cấu hình một AI provider cho mỗi môi trường.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_BASE_URL=

# Ví dụ provider tương thích OpenAI (bỏ comment và thay AI_MODEL khi sử dụng):
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1

# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1

AGENT_MAX_ITERATIONS=10
AGENT_MAX_QUERY_COUNT=5
SQL_MAX_ROWS=100
SQL_TIMEOUT_MS=5000
